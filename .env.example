# ── Server ─────────────────────────────────────────────
PORT=8787

# ── Shopify Admin API ──────────────────────────────────
# Custom App im Shopify-Admin anlegen (Einstellungen → Apps → Apps entwickeln)
# Scopes: read_orders, write_orders (für Status-Tags), read_customers
SHOPIFY_STORE_DOMAIN=dein-shop.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
# Webhook-Secret für orders/create + orders/updated (optional)
SHOPIFY_WEBHOOK_SECRET=
# Produktionsstand als Tag "naehstatus:<stufe>" zurück an Shopify schreiben
SHOPIFY_WRITE_STAGE_TAGS=false
# Standard-Vorlaufzeit in Tagen, wenn die Bestellung kein Fälligkeitsdatum hat
DEFAULT_LEAD_DAYS=5

# ── Claude API (Textil-Lab Agent) ──────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Obsidian (Wissensdatenbank) ────────────────────────
# Absoluter Pfad zum Obsidian-Vault auf dem Rechner, auf dem der Server läuft
OBSIDIAN_VAULT_PATH=
# Unterordner im Vault, in den neue Einträge geschrieben werden
OBSIDIAN_NOTES_FOLDER=Textil-Lab

# ── Werkstatt ──────────────────────────────────────────
WORKSHOP_NAME=Studio Nord
OWNER_NAME=Sven
