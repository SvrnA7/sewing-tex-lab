# Lokal: als .env neben package.json. Auf Vercel: dieselben Namen unter
# Project → Settings → Environment Variables eintragen (nie echte Werte in diese Datei).

# ── Server ─────────────────────────────────────────────
PORT=8787

# ── Zugang ─────────────────────────────────────────────
# Passwort für die App. Auf Vercel Pflicht, weil die Adresse öffentlich ist.
APP_PASSWORD=
# Zeitzone für Tagesziel und Monatsumsatz
APP_TIMEZONE=Europe/Berlin

# ── Datenbank (Neon / Postgres) ────────────────────────
# Auf Vercel nötig, damit Daten erhalten bleiben. Die Neon-Integration in Vercel setzt
# DATABASE_URL automatisch. Leer = lokale Datei data/db.json.
DATABASE_URL=

# ── Shopify Admin API ──────────────────────────────────
# Custom App im Shopify-Admin anlegen (Einstellungen → Apps → Apps entwickeln)
# Scopes: read_orders, write_orders (für Status-Tags), read_customers
SHOPIFY_STORE_DOMAIN=9f5402-b4.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
# Webhook-Secret für orders/create + orders/updated (optional)
SHOPIFY_WEBHOOK_SECRET=
# Produktionsstand als Tag "naehstatus:<stufe>" zurück an Shopify schreiben
SHOPIFY_WRITE_STAGE_TAGS=false
# Standard-Vorlaufzeit in Tagen, wenn die Bestellung kein Fälligkeitsdatum hat
DEFAULT_LEAD_DAYS=5

# ── Claude API (Textil-Lab Agent) ──────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Obsidian (Wissensdatenbank) ────────────────────────
# Variante A (Vercel): Vault liegt in einem privaten GitHub-Repo (Obsidian-Git-Plugin)
OBSIDIAN_GITHUB_REPO=
OBSIDIAN_GITHUB_TOKEN=
OBSIDIAN_GITHUB_BRANCH=main
# Optional: Unterordner im Repo, in dem der Vault liegt
OBSIDIAN_GITHUB_DIR=
# Variante B (lokal): absoluter Pfad zum Vault auf dem Rechner, auf dem der Server läuft
OBSIDIAN_VAULT_PATH=
# Ohne A und B speichert die App das Wissen in ihrer eigenen Datenbank.
# Unterordner im Vault, in den neue Einträge geschrieben werden
OBSIDIAN_NOTES_FOLDER=Textil-Lab

# ── Vercel Cron (optional) ─────────────────────────────
# Wenn gesetzt, akzeptiert /api/cron/shopify-sync nur Aufrufe von Vercel Cron
CRON_SECRET=

# ── Werkstatt ──────────────────────────────────────────
WORKSHOP_NAME=Studio Nord
OWNER_NAME=Sven
